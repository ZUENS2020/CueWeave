                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="UsltCheck" Tag="uslt" Checked="ExportOption_Changed" Unchecked="ExportOption_Changed">
                                            <StackPanel>
                                                <TextBlock x:Name="UsltCheckTitle" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock x:Name="UsltCheckDetail" FontSize="11" Opacity=".7" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="SyltCheck" Tag="sylt" Checked="ExportOption_Changed" Unchecked="ExportOption_Changed">
                                            <StackPanel>
                                                <TextBlock x:Name="SyltCheckTitle" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock x:Name="SyltCheckDetail" FontSize="11" Opacity=".7" />
                                            </StackPanel>
                                        </CheckBox>
                                        <TextBlock x:Name="BilingualLabel" Margin="0,8,0,0" FontFamily="Consolas" FontSize="10" Text="BILINGUAL" />
                                        <ComboBox x:Name="BilingualPicker" SelectionChanged="Bilingual_Changed">
                                            <ComboBoxItem x:Name="BilingualOriginal" Content="Original only" Tag="original_only" />
                                            <ComboBoxItem x:Name="BilingualCombined" Content="Separate translation" Tag="bilingual" />
                                        </ComboBox>
                                        <NumberBox x:Name="OffsetBox" SpinButtonPlacementMode="Compact" ValueChanged="Offset_Changed" />
                                        <CheckBox x:Name="OverwriteCheck">
                                            <StackPanel>
                                                <TextBlock x:Name="OverwriteTitle" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock x:Name="OverwriteHint" FontSize="11" Opacity=".7" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </CheckBox>
                                        <TextBlock x:Name="AdaptersNote" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Grid>
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock x:Name="ExportOutputLabel" FontFamily="Consolas" FontSize="9" Opacity=".6" />
                                    <TextBlock x:Name="ExportHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="SaveCueSheetButton" Content="Save Cue Sheet…" Click="ExportCueSheet_Click" />
                                    <Button x:Name="ExportFinalButton" Style="{StaticResource AccentButtonStyle}" Content="Export Final…" Click="Export_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView>
        <Grid x:Name="WelcomePanel">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
            <StackPanel Margin="64" VerticalAlignment="Center" Spacing="18">
                <TextBlock x:Name="WelcomeKicker" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CUEWEAVE / 02" />
                <TextBlock x:Name="WelcomeHeadline" FontSize="40" FontWeight="SemiBold" Text="Lyrics, aligned&#x0a;to your track." />
                <TextBlock x:Name="WelcomeBody" MaxWidth="560" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                           Text="Transfer metadata. Rebuild timing against the target vocal. Adjust Final times on the timeline." />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="WelcomeNew" Style="{StaticResource AccentButtonStyle}" Content="New Song Project…" Click="NewProject_Click" />
                    <Button x:Name="WelcomeOpen" Content="Open Project…" Click="OpenProject_Click" />
                </StackPanel>
                <TextBlock x:Name="WelcomePipeline" Margin="0,28,0,0" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="SOURCE TEXT  →  TARGET AUDIO  →  FINAL TIMELINE" />
            </StackPanel>
            <Border Grid.Column="1" Background="#12327F9F" />
        </Grid>
        </Grid>

        <Grid Grid.Row="2" Padding="14,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="StatusPlayback" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button x:Name="StatusPlayButton" Width="32" Padding="4,0" Click="Play_Click" AllowFocusOnInteraction="False" IsTabStop="False" />
                <TextBlock x:Name="StatusTime" VerticalAlignment="Center" FontFamily="Consolas" FontSize="11" Text="00:00.000 / 00:00.000" />
                <TextBlock x:Name="StatusLoop" VerticalAlignment="Center" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource CueAccentBrush}" />
            </StackPanel>
            <ProgressBar x:Name="BusyBar" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock x:Name="ActivityText" VerticalAlignment="Center" FontFamily="Consolas" FontSize="10" Text="No project" />
                <Button x:Name="CancelButton" Padding="6,0" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
