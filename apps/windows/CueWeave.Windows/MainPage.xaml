<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CueWeave.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:timeline="using:CueWeave.WinUI.Timeline">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Collapsed">
            <AppBarButton x:Name="NewButton" Icon="Add" Label="New" Click="NewProject_Click">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="OpenButton" Icon="Import" Label="Open" Click="OpenProject_Click">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="SaveButton" Icon="Save" Label="Save" Click="Save_Click" IsEnabled="False">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="S" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="RevertButton" Icon="Refresh" Label="Revert" Click="Revert_Click" IsEnabled="False" />
            <AppBarSeparator />
            <AppBarButton x:Name="UndoButton" Icon="Undo" Label="Undo" Click="Undo_Click" IsEnabled="False" />
            <AppBarButton x:Name="RedoButton" Icon="Redo" Label="Redo" Click="Redo_Click" IsEnabled="False" />
            <CommandBar.Content>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="12">
                    <TextBlock Margin="8,0,0,0" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource CueAccentBrush}" Text="CUEWEAVE" />
                    <TextBlock x:Name="ProjectTitle" FontSize="16" FontWeight="SemiBold" Text="Lyrics, aligned to your track." />
                    <Border x:Name="SavePill" Padding="8,3" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <TextBlock x:Name="SaveStateText" FontFamily="Consolas" FontSize="9" Text="NO PROJECT" />
                    </Border>
                </StackPanel>
            </CommandBar.Content>
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="SettingsButton" Icon="Setting" Label="Provider settings" Click="Settings_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <NavigationView x:Name="Navigation" Grid.Row="1" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False" PaneDisplayMode="Left" OpenPaneLength="225"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavSource" Content="Source" Tag="source"><NavigationViewItem.Icon><SymbolIcon Symbol="Import" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="NavMetadata" Content="Metadata" Tag="metadata"><NavigationViewItem.Icon><SymbolIcon Symbol="Tag" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="NavLyrics" Content="Lyrics" Tag="lyrics"><NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="NavTranslation" Content="Translation" Tag="translation"><NavigationViewItem.Icon><SymbolIcon Symbol="Character" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="NavAlignment" Content="Alignment" Tag="alignment"><NavigationViewItem.Icon><SymbolIcon Symbol="Audio" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="NavExport" Content="Export" Tag="export"><NavigationViewItem.Icon><SymbolIcon Symbol="SaveLocal" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Margin="14" Spacing="4">
                    <TextBlock x:Name="PaneFooterLabel" FontFamily="Consolas" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="ALIGNMENT PROVIDER" />
                    <TextBlock x:Name="ProviderState" FontFamily="Consolas" FontSize="11" Text="OpenRouter · key missing" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid x:Name="WelcomePanel">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="240" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="64" VerticalAlignment="Center" Spacing="18">
                        <TextBlock x:Name="WelcomeKicker" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="CUEWEAVE / 02" />
                        <TextBlock x:Name="WelcomeHeadline" FontSize="40" FontWeight="SemiBold" Text="Lyrics, aligned&#x0a;to your track." />
                        <TextBlock x:Name="WelcomeBody" MaxWidth="560" FontSize="18" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="Transfer metadata. Rebuild timing against the target vocal. Adjust Final times on the timeline." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button x:Name="WelcomeNew" Style="{StaticResource AccentButtonStyle}" Content="New Song Project…" Click="NewProject_Click" />
                            <Button x:Name="WelcomeOpen" Content="Open Project…" Click="OpenProject_Click" />
                        </StackPanel>
                        <TextBlock x:Name="WelcomePipeline" Margin="0,28,0,0" FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="SOURCE TEXT  →  TARGET AUDIO  →  FINAL TIMELINE" />
                    </StackPanel>
                    <Border Grid.Column="1" Background="#12327F9F" />
                </Grid>

                <Grid x:Name="SourcePanel" Visibility="Collapsed" Padding="24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Spacing="3"><TextBlock x:Name="SourceHeading" FontSize="24" FontWeight="SemiBold" Text="Source" /><TextBlock x:Name="SourceSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Information source and target timing authority" /></StackPanel>
                    <Grid Grid.Row="1" Margin="0,20,0,0" ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Border Padding="18" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                            <StackPanel Spacing="10"><TextBlock x:Name="SourceRole" FontFamily="Consolas" FontSize="10" Text="INFORMATION SOURCE" /><TextBlock x:Name="SourceName" FontSize="18" FontWeight="SemiBold" Text="Missing" /><TextBlock x:Name="SourcePath" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="SourceDetails" FontFamily="Consolas" FontSize="11" /></StackPanel>
                        </Border>
                        <Border Grid.Column="1" Padding="18" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                            <StackPanel Spacing="10"><TextBlock x:Name="TargetRole" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource CueAccentBrush}" Text="TARGET AUDIO · ONLY TIMING AUTHORITY" /><TextBlock x:Name="TargetName" FontSize="18" FontWeight="SemiBold" Text="Missing" /><TextBlock x:Name="TargetPath" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="TargetDetails" FontFamily="Consolas" FontSize="11" /><Button x:Name="ReplaceTargetButton" HorizontalAlignment="Left" Content="Replace Target…" Click="ReplaceTarget_Click" /></StackPanel>
                        </Border>
                    </Grid>
                </Grid>

                <Grid x:Name="MetadataPanel" Visibility="Collapsed" Padding="24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Spacing="3"><TextBlock x:Name="MetadataHeading" FontSize="24" FontWeight="SemiBold" Text="Metadata" /><TextBlock x:Name="MetadataSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Source and target stay visible; only Draft is exported" /></StackPanel>
                    <Grid Grid.Row="1" Margin="0,20,0,0" RowSpacing="8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock x:Name="MetaColSource" Grid.Column="1" FontFamily="Consolas" Text="SOURCE" /><TextBlock x:Name="MetaColTarget" Grid.Column="2" FontFamily="Consolas" Text="TARGET" /><TextBlock x:Name="MetaColDraft" Grid.Column="3" FontFamily="Consolas" Foreground="{StaticResource CueAccentBrush}" Text="DRAFT / EXPORTED" />
                        <TextBlock x:Name="MetaLabelTitle" Grid.Row="1" VerticalAlignment="Center" FontFamily="Consolas" Text="TITLE" /><TextBlock x:Name="SourceTitle" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" /><TextBlock x:Name="TargetTitle" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" /><TextBox x:Name="DraftTitle" Grid.Row="1" Grid.Column="3" LostFocus="Metadata_LostFocus" />
                        <TextBlock x:Name="MetaLabelArtist" Grid.Row="2" VerticalAlignment="Center" FontFamily="Consolas" Text="ARTIST" /><TextBlock x:Name="SourceArtist" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" /><TextBlock x:Name="TargetArtist" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" /><TextBox x:Name="DraftArtist" Grid.Row="2" Grid.Column="3" LostFocus="Metadata_LostFocus" />
                        <TextBlock x:Name="MetaLabelAlbum" Grid.Row="3" VerticalAlignment="Center" FontFamily="Consolas" Text="ALBUM" /><TextBlock x:Name="SourceAlbum" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" /><TextBlock x:Name="TargetAlbum" Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" /><TextBox x:Name="DraftAlbum" Grid.Row="3" Grid.Column="3" LostFocus="Metadata_LostFocus" />
                        <TextBlock x:Name="MetaLabelAlbumArtist" Grid.Row="4" VerticalAlignment="Center" FontFamily="Consolas" Text="ALBUM ARTIST" /><TextBlock x:Name="SourceAlbumArtist" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" /><TextBlock x:Name="TargetAlbumArtist" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" /><TextBox x:Name="DraftAlbumArtist" Grid.Row="4" Grid.Column="3" LostFocus="Metadata_LostFocus" />
                        <TextBlock x:Name="MetaLabelDate" Grid.Row="5" VerticalAlignment="Center" FontFamily="Consolas" Text="DATE" /><TextBlock x:Name="SourceDate" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" /><TextBlock x:Name="TargetDate" Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" /><TextBox x:Name="DraftDate" Grid.Row="5" Grid.Column="3" LostFocus="Metadata_LostFocus" />
                    </Grid>
                </Grid>

                <Grid x:Name="LyricsPanel" Visibility="Collapsed" Padding="24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid ColumnSpacing="12"><StackPanel Spacing="3"><TextBlock x:Name="LyricsHeading" FontSize="24" FontWeight="SemiBold" Text="Lyrics" /><TextBlock x:Name="LyricsSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Provider timestamps are discarded before this project sees them" /></StackPanel><StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8"><Button x:Name="AddLyricsButton" Content="Add Lines…" Click="AddLyrics_Click" /><Button x:Name="ImportLyricsButton" Content="Import Text…" Click="ImportLyrics_Click" /><Button x:Name="FetchLyricsButton" Content="Fetch NetEase" Click="FetchLyrics_Click" /></StackPanel></Grid>
                    <StackPanel Grid.Row="1" Margin="0,12,0,0" Spacing="8">
                        <TextBlock x:Name="LyricsCreditsLabel" FontSize="12" FontWeight="SemiBold" Text="TITLE / CREDITS" />
                        <ListView x:Name="LyricsCreditsList" MaxHeight="120">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="8" Padding="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Label}" LostFocus="CreditLabel_LostFocus" />
                                        <TextBox Grid.Column="1" Text="{Binding Value}" LostFocus="CreditValue_LostFocus" />
                                        <Button Grid.Column="2" Content="−" Click="RemoveCredit_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Button x:Name="AddCreditButton" Content="+" Click="AddCredit_Click" HorizontalAlignment="Left" />
                    </StackPanel>
                    <ListView x:Name="LyricsList" Grid.Row="2" Margin="0,16,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,5" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3">
                                        <TextBlock FontSize="16" Text="{Binding Original}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Translation}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="+" Click="InsertAfter_Click" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid x:Name="TranslationPanel" Visibility="Collapsed" Padding="24">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <StackPanel Spacing="3"><TextBlock x:Name="TranslationHeading" FontSize="24" FontWeight="SemiBold" Text="Translation" /><TextBlock x:Name="TranslationSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Line-level only. Originals and timing stay untouched. Gemini uses the Align key, text only." /></StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="TargetLanguageBox" Width="180" Text="Simplified Chinese" PlaceholderText="Target language" />
                            <Button x:Name="ImportTranslationButton" Content="Import Text…" Click="ImportTranslations_Click" />
                            <Button x:Name="ClearTranslationButton" Content="Clear All" Click="ClearTranslations_Click" />
                            <Button x:Name="TranslateButton" Style="{StaticResource AccentButtonStyle}" Content="Translate with Gemini" Click="Translate_Click" />
                        </StackPanel>
                    </Grid>
                    <ListView x:Name="TranslationList" Grid.Row="1" Margin="0,16,0,0">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,6" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <TextBlock FontSize="15" TextWrapping="Wrap" Text="{Binding Original}" />
                                    <TextBox Grid.Column="1" Text="{Binding Translation}" LostFocus="Translation_LostFocus" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid x:Name="AlignmentPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <CommandBar DefaultLabelPosition="Collapsed" IsOpen="False">
                        <AppBarButton x:Name="PlayButton" Icon="Play" Label="Play / Pause" Click="Play_Click" />
                        <CommandBar.Content>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <ComboBox x:Name="SpeedPicker" Width="82" SelectedIndex="2" SelectionChanged="Speed_Changed">
                                    <ComboBoxItem Content="0.50×" Tag="0.5" /><ComboBoxItem Content="0.75×" Tag="0.75" /><ComboBoxItem Content="1.00×" Tag="1" /><ComboBoxItem Content="1.25×" Tag="1.25" /><ComboBoxItem Content="1.50×" Tag="1.5" /><ComboBoxItem Content="2.00×" Tag="2" />
                                </ComboBox>
                                <Button x:Name="LoopAButton" Content="A" Click="LoopA_Click" ToolTipService.ToolTip="Set loop start (A)" />
                                <Button x:Name="LoopBButton" Content="B" Click="LoopB_Click" ToolTipService.ToolTip="Set loop end (B)" />
                                <Button x:Name="LoopClearButton" Content="Clear" Click="LoopClear_Click" />
                                <ToggleButton x:Name="FollowButton" Content="Follow" Checked="Follow_Changed" Unchecked="Follow_Changed" ToolTipService.ToolTip="Keep the playhead in view" />
                                <ToggleButton x:Name="NextButton" Content="Next" Checked="Next_Changed" Unchecked="Next_Changed" ToolTipService.ToolTip="Keep selection on the lyric after the playhead" />
                                <Button x:Name="MarkButton" Content="Mark" Click="Mark_Click" />
                                <Button x:Name="AlignButton" Style="{StaticResource AccentButtonStyle}" Content="Run Gemini" Click="Align_Click" />
                                <Button x:Name="RestoreButton" Content="Restore AI" Click="RestoreGemini_Click" />
                            </StackPanel>
                        </CommandBar.Content>
                        <CommandBar.SecondaryCommands>
                            <AppBarButton x:Name="HotkeyHintButton" Label="Space play; Return select playing lyric; Tab next lyric; arrows seek/navigate; Esc clear A-B; =/− rate; Ctrl+=/− zoom." />
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="320" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,1,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel>
                                <StackPanel x:Name="CreditIntroBanner" Visibility="Collapsed" Orientation="Horizontal" Padding="10,6" Spacing="8">
                                    <TextBlock x:Name="CreditIntroText" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                                    <Button x:Name="MergeCreditsButton" Click="MergeCredits_Click" />
                                </StackPanel>
                                <ListView x:Name="CreditsList" MaxHeight="140" SelectionMode="None" IsItemClickEnabled="True" ItemClick="CreditsList_ItemClick">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Padding="10,6" Spacing="2">
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Text}" TextWrapping="Wrap" />
                                                <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Time}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                </StackPanel>
                                <ListView Grid.Row="1" x:Name="AlignmentList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="AlignmentList_ItemClick">
                                <ListView.ItemTemplate><DataTemplate><Grid Padding="10,8"><Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{Binding Id}" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock FontSize="15" Text="{Binding Text}" TextWrapping="Wrap" /><TextBlock FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Timing.Final.TimeMs}" /></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
                            </ListView>
                            </Grid>
                        </Border>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="150" /></Grid.RowDefinitions>
                            <timeline:TimelineControl x:Name="Timeline" MinHeight="360" />
                            <Border Grid.Row="1" Padding="14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel><TextBlock x:Name="InspectorLabel" FontFamily="Consolas" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="NO SEGMENT SELECTED" /><TextBlock x:Name="InspectorText" FontSize="19" FontWeight="SemiBold" Text="Press Enter to select the playing lyric, or Tab for the next one." /><TextBlock x:Name="InspectorTranslation" Margin="0,4,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Translation is edited on the Translation page." /></StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,9,0,0" Orientation="Horizontal" Spacing="12"><TextBlock x:Name="GeminiTime" FontFamily="Consolas" Text="GEMINI —" /><TextBlock x:Name="FinalTime" FontFamily="Consolas" Text="FINAL —" /></StackPanel>
                                    <StackPanel Grid.Row="2" Margin="0,9,0,0" Orientation="Horizontal" Spacing="6"><Button Content="−50" Click="Nudge_Click" Tag="-50" /><Button Content="−10" Click="Nudge_Click" Tag="-10" /><Button Content="−1" Click="Nudge_Click" Tag="-1" /><Button Content="+1" Click="Nudge_Click" Tag="1" /><Button Content="+10" Click="Nudge_Click" Tag="10" /><Button Content="+50" Click="Nudge_Click" Tag="50" /><Button x:Name="PlayAroundButton" Content="Play 2s Before" Click="PlayAround_Click" /><Button x:Name="UseGeminiButton" Content="Use Gemini" Click="UseGemini_Click" /></StackPanel>
                                </Grid>
                            </Border>
                            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Orientation="Horizontal" Spacing="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"><TextBlock x:Name="PlaybackTime" VerticalAlignment="Center" FontFamily="Consolas" Text="00:00.000" /><Slider x:Name="ZoomSlider" Width="150" Minimum="1" Maximum="100" Value="1" StepFrequency=".5" ValueChanged="Zoom_Changed" /><TextBlock x:Name="ZoomText" Width="48" VerticalAlignment="Center" FontFamily="Consolas" Text="1.0×" /></StackPanel>
                        </Grid>
                    </Grid>
                </Grid>

                <Grid x:Name="ExportPanel" Visibility="Collapsed" Padding="24">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
                        <StackPanel Spacing="12" VerticalAlignment="Center">
                            <TextBlock x:Name="ExportHeading" FontSize="24" FontWeight="SemiBold" Text="Final Export" />
                            <TextBlock x:Name="ExportHint" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Text="Export Final writes a new MP3 without re-encoding. Save Cue Sheet writes player-agnostic JSON later plugins consume." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="SaveCueSheetButton" Content="Save Cue Sheet…" Click="ExportCueSheet_Click" />
                                <Button x:Name="ExportFinalButton" Style="{StaticResource AccentButtonStyle}" Content="Export Final…" Click="Export_Click" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="10">
                            <TextBlock x:Name="AdaptersLabel" FontFamily="Consolas" FontSize="10" Text="PLAYER ADAPTERS" />
                            <CheckBox x:Name="LrcCheck" Content="LRC sidecar" Tag="lrc" Checked="ExportOption_Changed" Unchecked="ExportOption_Changed" />
                            <CheckBox x:Name="UsltCheck" Content="USLT embedded lyrics" Tag="uslt" Checked="ExportOption_Changed" Unchecked="ExportOption_Changed" />
                            <CheckBox x:Name="SyltCheck" Content="SYLT synced tags" Tag="sylt" Checked="ExportOption_Changed" Unchecked="ExportOption_Changed" />
                            <TextBlock x:Name="BilingualLabel" Margin="0,8,0,0" FontFamily="Consolas" FontSize="10" Text="BILINGUAL" />
                            <ComboBox x:Name="BilingualPicker" SelectionChanged="Bilingual_Changed">
                                <ComboBoxItem x:Name="BilingualOriginal" Content="Original only" Tag="original_only" />
                                <ComboBoxItem x:Name="BilingualCombined" Content="Separate translation" Tag="bilingual" />
                            </ComboBox>
                            <NumberBox x:Name="OffsetBox" Header="Export offset (ms)" Minimum="-2000" Maximum="2000" SmallChange="10" SpinButtonPlacementMode="Compact" ValueChanged="Offset_Changed" />
                            <CheckBox x:Name="OverwriteCheck" Content="Overwrite existing output" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>

        <Grid Grid.Row="2" Padding="14,0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="ActivityText" VerticalAlignment="Center" FontFamily="Consolas" FontSize="10" Text="No project" />
            <ProgressBar x:Name="BusyBar" Grid.Column="1" Margin="16,0" VerticalAlignment="Center" IsIndeterminate="True" Visibility="Collapsed" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"><Button x:Name="CancelButton" Padding="6,0" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click" /></StackPanel>
        </Grid>
    </Grid>
</Page>
