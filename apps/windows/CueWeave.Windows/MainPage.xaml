<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="CueWeave.WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:timeline="using:CueWeave.WinUI.Timeline"
    KeyboardAcceleratorPlacementMode="Hidden">
    <Page.Resources>
        <Style x:Key="MetaDraftBox" TargetType="TextBox">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="MetaValueText" TargetType="TextBlock">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SegmentListItem" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </Page.Resources>
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="54" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right">
            <AppBarButton x:Name="NewButton" Icon="Add" Label="New" Click="NewProject_Click" KeyboardAcceleratorPlacementMode="Hidden">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="OpenButton" Icon="Import" Label="Open" Click="OpenProject_Click" KeyboardAcceleratorPlacementMode="Hidden">
                <AppBarButton.KeyboardAccelerators>
                    <KeyboardAccelerator Key="O" Modifiers="Control" />
                </AppBarButton.KeyboardAccelerators>
            </AppBarButton>
            <AppBarButton x:Name="UndoButton" Icon="Undo" Label="Undo" Click="Undo_Click" IsEnabled="False" />
            <AppBarButton x:Name="RedoButton" Icon="Redo" Label="Redo" Click="Redo_Click" IsEnabled="False" />
            <AppBarButton x:Name="SettingsButton" Icon="Setting" Label="Settings" Click="Settings_Click" />
            <CommandBar.Content>
                <Grid Margin="16,0,0,0" VerticalAlignment="Center" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1">
                        <TextBlock x:Name="ChromePageTitle" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Text="CUEWEAVE" />
                        <TextBlock x:Name="ChromePageDetail" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Lyrics, aligned to your track." />
                    </StackPanel>
                    <Border x:Name="SavePill" Grid.Column="1" Padding="8,3" CornerRadius="10" VerticalAlignment="Center" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <TextBlock x:Name="SaveStateText" FontFamily="Consolas" FontSize="9" Text="NO PROJECT" />
                    </Border>
                </Grid>
            </CommandBar.Content>
        </CommandBar>

        <Grid Grid.Row="1">
        <NavigationView x:Name="Navigation" Visibility="Collapsed" IsBackButtonVisible="Collapsed" IsSettingsVisible="False"
                        IsPaneToggleButtonVisible="False" PaneDisplayMode="Left" OpenPaneLength="230"
                        SelectionChanged="Navigation_SelectionChanged">
            <NavigationView.PaneHeader>
                <StackPanel Margin="14,8,14,4" Spacing="3">
                    <TextBlock FontFamily="Consolas" FontSize="10" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="CUEWEAVE" />
                    <TextBlock x:Name="PaneProjectTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="CueWeave" />
                    <TextBlock x:Name="PaneProjectPath" FontFamily="Consolas" FontSize="9" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="NoWrap" />
                </StackPanel>
            </NavigationView.PaneHeader>
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="NavSource" Content="Source" Tag="source"><NavigationViewItem.Icon><SymbolIcon Symbol="Import" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="NavMetadata" Content="Metadata" Tag="metadata"><NavigationViewItem.Icon><SymbolIcon Symbol="Tag" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="NavLyrics" Content="Lyrics" Tag="lyrics"><NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="NavTranslation" Content="Translation" Tag="translation"><NavigationViewItem.Icon><SymbolIcon Symbol="Character" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="NavAlignment" Content="Alignment" Tag="alignment"><NavigationViewItem.Icon><SymbolIcon Symbol="Audio" /></NavigationViewItem.Icon></NavigationViewItem>
                <NavigationViewItem x:Name="NavExport" Content="Export" Tag="export"><NavigationViewItem.Icon><SymbolIcon Symbol="SaveLocal" /></NavigationViewItem.Icon></NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.PaneFooter>
                <StackPanel Margin="14" Spacing="4">
                    <TextBlock x:Name="PaneFooterLabel" FontFamily="Consolas" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="ALIGNMENT PROVIDER" />
                    <TextBlock x:Name="ProviderState" FontFamily="Consolas" FontSize="11" Text="OpenRouter · key missing" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid x:Name="SourcePanel" Visibility="Collapsed">
                    <ScrollViewer Padding="22">
                        <StackPanel MaxWidth="1120" Spacing="18">
                            <Grid>
                                <StackPanel Spacing="3">
                                    <TextBlock x:Name="SourceHeading" FontSize="24" FontWeight="SemiBold" Text="Source" />
                                    <TextBlock x:Name="SourceSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Information source and target timing authority" />
                                </StackPanel>
                                <Border x:Name="TimingAuthorityPill" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,3" CornerRadius="10" Background="#32327F9F">
                                    <TextBlock x:Name="TimingAuthorityText" FontFamily="Consolas" FontSize="10" Text="Target = timing authority" />
                                </Border>
                            </Grid>
                            <Grid ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="210" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel Spacing="10">
                                        <TextBlock x:Name="SourceCoverLabel" FontFamily="Consolas" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="REFERENCE COVER" />
                                        <Image x:Name="SourceCover" Width="178" Height="178" Stretch="Uniform" />
                                        <TextBlock x:Name="SourceCoverCaption" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="12">
                                    <Border Padding="18" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Spacing="10">
                                            <TextBlock x:Name="SourceRole" FontFamily="Consolas" FontSize="10" Text="INFORMATION SOURCE" />
                                            <TextBlock x:Name="SourceName" FontSize="18" FontWeight="SemiBold" Text="Missing" />
                                            <TextBlock x:Name="SourcePath" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="SourceDetails" FontFamily="Consolas" FontSize="11" />
                                            <Button x:Name="SourceFixedButton" HorizontalAlignment="Left" IsEnabled="False" Content="Fixed for this project" />
                                        </StackPanel>
                                    </Border>
                                    <Border Padding="18" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                        <StackPanel Spacing="10">
                                            <TextBlock x:Name="TargetRole" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource CueAccentBrush}" Text="TARGET AUDIO · ONLY TIMING AUTHORITY" />
                                            <TextBlock x:Name="TargetName" FontSize="18" FontWeight="SemiBold" Text="Missing" />
                                            <TextBlock x:Name="TargetPath" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock x:Name="TargetDetails" FontFamily="Consolas" FontSize="11" />
                                            <Button x:Name="ReplaceTargetButton" HorizontalAlignment="Left" Content="Replace Target…" Click="ReplaceTarget_Click" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Border Padding="16" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="TimingIsolationTitle" FontFamily="Consolas" FontSize="10" FontWeight="SemiBold" Text="TIMING ISOLATION" />
                                    <TextBlock x:Name="TimingIsolationBody" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="MetadataPanel" Visibility="Collapsed">
                    <ScrollViewer Padding="22" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid MaxWidth="1200" MinWidth="0" HorizontalAlignment="Stretch" RowSpacing="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="3">
                                <TextBlock x:Name="MetadataHeading" FontSize="24" FontWeight="SemiBold" Text="Metadata" />
                                <TextBlock x:Name="MetadataSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Source and target stay visible; only Draft is exported" />
                            </StackPanel>
                            <Grid Grid.Row="1" ColumnSpacing="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="*" MinWidth="0" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="14" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" VerticalAlignment="Top">
                                    <StackPanel Spacing="10">
                                        <TextBlock x:Name="MetaCoverLabel" FontFamily="Consolas" FontSize="9" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="DRAFT COVER" />
                                        <Image x:Name="MetaCover" Width="198" Height="198" Stretch="Uniform" />
                                        <Button x:Name="ChooseCoverButton" HorizontalAlignment="Left" Content="Choose Cover…" Click="ChooseCover_Click" />
                                        <TextBlock x:Name="MetaCoverHint" FontSize="11" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Grid Grid.Column="1" MinWidth="0" HorizontalAlignment="Stretch">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Padding="12" ColumnSpacing="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="MetaColField" FontFamily="Consolas" FontSize="10" Text="FIELD" />
                                        <TextBlock x:Name="MetaColSource" Grid.Column="1" FontFamily="Consolas" FontSize="10" Text="SOURCE" />
                                        <TextBlock x:Name="MetaColTarget" Grid.Column="2" FontFamily="Consolas" FontSize="10" Text="TARGET" />
                                        <TextBlock x:Name="MetaColDraft" Grid.Column="3" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource CueAccentBrush}" Text="DRAFT" />
                                    </Grid>
                                    <Grid Grid.Row="1" Padding="12,8" ColumnSpacing="12" RowSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="92" />
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                            <ColumnDefinition Width="*" MinWidth="0" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock x:Name="MetaLabelTitle" VerticalAlignment="Center" FontFamily="Consolas" Text="TITLE" />
                                        <Grid Grid.Column="1" MinWidth="0" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SourceTitle" Style="{StaticResource MetaValueText}" />
                                            <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="title|source" Click="AdoptMetadata_Click" />
                                        </Grid>
                                        <Grid Grid.Column="2" MinWidth="0" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TargetTitle" Style="{StaticResource MetaValueText}" />
                                            <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="title|target" Click="AdoptMetadata_Click" />
                                        </Grid>
                                        <TextBox x:Name="DraftTitle" Grid.Column="3" Style="{StaticResource MetaDraftBox}" LostFocus="Metadata_LostFocus" />

                                        <TextBlock x:Name="MetaLabelArtist" Grid.Row="1" VerticalAlignment="Center" FontFamily="Consolas" Text="ARTIST" />
                                        <Grid Grid.Row="1" Grid.Column="1" MinWidth="0" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SourceArtist" Style="{StaticResource MetaValueText}" />
                                            <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="artists|source" Click="AdoptMetadata_Click" />
                                        </Grid>
                                        <Grid Grid.Row="1" Grid.Column="2" MinWidth="0" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TargetArtist" Style="{StaticResource MetaValueText}" />
                                            <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="artists|target" Click="AdoptMetadata_Click" />
                                        </Grid>
                                        <TextBox x:Name="DraftArtist" Grid.Row="1" Grid.Column="3" MinHeight="56" Style="{StaticResource MetaDraftBox}" LostFocus="Metadata_LostFocus" />

                                        <TextBlock x:Name="MetaLabelAlbumArtist" Grid.Row="2" VerticalAlignment="Center" FontFamily="Consolas" TextWrapping="Wrap" Text="ALBUM ARTIST" />
                                        <Grid Grid.Row="2" Grid.Column="1" MinWidth="0" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SourceAlbumArtist" Style="{StaticResource MetaValueText}" />
                                            <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="albumArtist|source" Click="AdoptMetadata_Click" />
                                        </Grid>
                                        <Grid Grid.Row="2" Grid.Column="2" MinWidth="0" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TargetAlbumArtist" Style="{StaticResource MetaValueText}" />
                                            <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="albumArtist|target" Click="AdoptMetadata_Click" />
                                        </Grid>
                                        <TextBox x:Name="DraftAlbumArtist" Grid.Row="2" Grid.Column="3" Style="{StaticResource MetaDraftBox}" LostFocus="Metadata_LostFocus" />

                                        <TextBlock x:Name="MetaLabelAlbum" Grid.Row="3" VerticalAlignment="Center" FontFamily="Consolas" Text="ALBUM" />
                                        <Grid Grid.Row="3" Grid.Column="1" MinWidth="0" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SourceAlbum" Style="{StaticResource MetaValueText}" />
                                            <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="album|source" Click="AdoptMetadata_Click" />
                                        </Grid>
                                        <Grid Grid.Row="3" Grid.Column="2" MinWidth="0" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TargetAlbum" Style="{StaticResource MetaValueText}" />
                                            <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="album|target" Click="AdoptMetadata_Click" />
                                        </Grid>
                                        <TextBox x:Name="DraftAlbum" Grid.Row="3" Grid.Column="3" Style="{StaticResource MetaDraftBox}" LostFocus="Metadata_LostFocus" />

                                        <TextBlock x:Name="MetaLabelDate" Grid.Row="4" VerticalAlignment="Center" FontFamily="Consolas" Text="DATE" />
                                        <Grid Grid.Row="4" Grid.Column="1" MinWidth="0" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="SourceDate" Style="{StaticResource MetaValueText}" />
                                            <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="date|source" Click="AdoptMetadata_Click" />
                                        </Grid>
                                        <Grid Grid.Row="4" Grid.Column="2" MinWidth="0" ColumnSpacing="4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock x:Name="TargetDate" Style="{StaticResource MetaValueText}" />
                                            <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="date|target" Click="AdoptMetadata_Click" />
                                        </Grid>
                                        <TextBox x:Name="DraftDate" Grid.Row="4" Grid.Column="3" Style="{StaticResource MetaDraftBox}" LostFocus="Metadata_LostFocus" />
                                    </Grid>
                                    <Expander x:Name="MetaAdvanced" Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                        <Expander.Header>
                                            <TextBlock x:Name="MetaAdvancedLabel" FontFamily="Consolas" FontSize="10" Text="ADVANCED METADATA" />
                                        </Expander.Header>
                                        <Grid Padding="12,8" ColumnSpacing="12" RowSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="92" />
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                                <ColumnDefinition Width="*" MinWidth="0" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock x:Name="MetaLabelTrack" VerticalAlignment="Center" FontFamily="Consolas" Text="TRACK" />
                                            <Grid Grid.Column="1" MinWidth="0" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="0" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="SourceTrack" Style="{StaticResource MetaValueText}" />
                                                <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="track|source" Click="AdoptMetadata_Click" />
                                            </Grid>
                                            <Grid Grid.Column="2" MinWidth="0" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="0" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TargetTrack" Style="{StaticResource MetaValueText}" />
                                                <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="track|target" Click="AdoptMetadata_Click" />
                                            </Grid>
                                            <TextBox x:Name="DraftTrack" Grid.Column="3" Style="{StaticResource MetaDraftBox}" LostFocus="Metadata_LostFocus" />

                                            <TextBlock x:Name="MetaLabelDisc" Grid.Row="1" VerticalAlignment="Center" FontFamily="Consolas" Text="DISC" />
                                            <Grid Grid.Row="1" Grid.Column="1" MinWidth="0" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="0" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="SourceDisc" Style="{StaticResource MetaValueText}" />
                                                <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="disc|source" Click="AdoptMetadata_Click" />
                                            </Grid>
                                            <Grid Grid.Row="1" Grid.Column="2" MinWidth="0" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="0" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TargetDisc" Style="{StaticResource MetaValueText}" />
                                                <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="disc|target" Click="AdoptMetadata_Click" />
                                            </Grid>
                                            <TextBox x:Name="DraftDisc" Grid.Row="1" Grid.Column="3" Style="{StaticResource MetaDraftBox}" LostFocus="Metadata_LostFocus" />

                                            <TextBlock x:Name="MetaLabelComposer" Grid.Row="2" VerticalAlignment="Center" FontFamily="Consolas" Text="COMPOSER" />
                                            <Grid Grid.Row="2" Grid.Column="1" MinWidth="0" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="0" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="SourceComposer" Style="{StaticResource MetaValueText}" />
                                                <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="composer|source" Click="AdoptMetadata_Click" />
                                            </Grid>
                                            <Grid Grid.Row="2" Grid.Column="2" MinWidth="0" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="0" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TargetComposer" Style="{StaticResource MetaValueText}" />
                                                <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="composer|target" Click="AdoptMetadata_Click" />
                                            </Grid>
                                            <TextBox x:Name="DraftComposer" Grid.Row="2" Grid.Column="3" Style="{StaticResource MetaDraftBox}" LostFocus="Metadata_LostFocus" />

                                            <TextBlock x:Name="MetaLabelLyricist" Grid.Row="3" VerticalAlignment="Center" FontFamily="Consolas" Text="LYRICIST" />
                                            <Grid Grid.Row="3" Grid.Column="1" MinWidth="0" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="0" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="SourceLyricist" Style="{StaticResource MetaValueText}" />
                                                <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="lyricist|source" Click="AdoptMetadata_Click" />
                                            </Grid>
                                            <Grid Grid.Row="3" Grid.Column="2" MinWidth="0" ColumnSpacing="4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" MinWidth="0" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="TargetLyricist" Style="{StaticResource MetaValueText}" />
                                                <Button Grid.Column="1" MinWidth="32" Padding="6,4" Content="→" Tag="lyricist|target" Click="AdoptMetadata_Click" />
                                            </Grid>
                                            <TextBox x:Name="DraftLyricist" Grid.Row="3" Grid.Column="3" Style="{StaticResource MetaDraftBox}" LostFocus="Metadata_LostFocus" />
                                        </Grid>
                                    </Expander>
                                </Grid>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <Grid x:Name="LyricsPanel" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="72" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="20,0" ColumnSpacing="12">
                        <StackPanel VerticalAlignment="Center" Spacing="3">
                            <TextBlock x:Name="LyricsHeading" FontSize="24" FontWeight="SemiBold" Text="Lyrics" />
                            <TextBlock x:Name="LyricsSubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Source text only · timing is always rebuilt" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button x:Name="RequestPreviewButton" Content="Request Preview" Click="RequestPreview_Click" />
                            <Button x:Name="AddLyricsButton" Content="Add Lines…" Click="AddLyrics_Click" />
                            <Button x:Name="ImportLyricsButton" Content="Import Text…" Click="ImportLyrics_Click" />
                            <Button x:Name="FetchLyricsButton" Content="Fetch NetEase" Click="FetchLyrics_Click" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="LyricsEmpty" Grid.Row="1" Padding="34" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16" MaxWidth="520">
                            <TextBlock x:Name="LyricsEmptyTitle" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Text="No lyric text" />
                            <TextBlock x:Name="LyricsEmptyDetail" TextWrapping="Wrap" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
